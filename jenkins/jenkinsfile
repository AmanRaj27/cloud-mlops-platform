pipeline {

 agent any

 environment {

     AWS_REGION='ap-south-1'
 }

 stages {

     stage('Checkout') {

         steps {

             git branch: 'main',
             url: 'https://github.com/yourrepo.git'
         }
     }

     stage('Terraform Init') {

         steps {

             dir('terraform') {

                 sh 'terraform init'
             }
         }
     }

     stage('Terraform Apply') {

         steps {

             dir('terraform') {

                 sh 'terraform apply -auto-approve'
             }
         }
     }

     stage('Train') {

         steps {

             sh 'python3 app/train.py'
         }
     }

     stage('Upload Model') {

         steps {

             sh 'python3 boto3/upload_model.py'
         }
     }

     stage('Build Docker Image') {

         steps {

             sh '''
             docker build \
             -t mlops-api \
             -f docker/Dockerfile .
             '''
         }
     }

     stage('Push To ECR') {

         steps {

             sh './scripts/ecr_push.sh'
         }
     }

 }
}
